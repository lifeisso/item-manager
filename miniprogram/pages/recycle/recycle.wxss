.clear-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.recycle-count {
  font-size: 26rpx;
  color: #999;
}

.recycle-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recycle-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-right: 20rpx;
}

.recycle-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recycle-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.recycle-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}