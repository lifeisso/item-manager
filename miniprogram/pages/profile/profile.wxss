.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.user-meta {
  font-size: 24rpx;
  color: #999;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-value-wrap {
  display: flex;
  align-items: center;
}

.setting-value {
  font-size: 28rpx;
  color: #667eea;
  margin-right: 8rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.setting-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.text-danger {
  color: #e74c3c;
}