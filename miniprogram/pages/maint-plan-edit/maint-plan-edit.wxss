.icon-select {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.icon-preview {
  font-size: 64rpx;
  margin-right: 16rpx;
}

.icon-hint {
  font-size: 24rpx;
  color: #999;
}

.emoji-picker {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.emoji-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border-radius: 12rpx;
  background: #fff;
}

.emoji-item:active {
  background: #e0e0e0;
}

.form-textarea {
  min-height: 120rpx;
  line-height: 1.5;
}

.picker-input {
  display: flex;
  align-items: center;
  color: #333;
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}