.records-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.records-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.records-count {
  font-size: 24rpx;
  color: #999;
}

.record-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.record-card:active {
  background: #f5f5f5;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-action {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.delete-text {
  font-size: 26rpx;
  color: #e74c3c;
  padding: 8rpx 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}